{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "decorators": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          },
          "target": "es2022",
          "keepClassNames": true
        },
        "module": {
          "type": "commonjs"
        },
        "sourceMaps": true
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|passport|passport-jwt|cache-manager|cache-manager-redis-yet|rxjs)/)"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
